# Sao chép thành .env.local khi chạy ở máy. Giá trị cục bộ lấy từ `supabase status -o env`.
# Đây là khóa công khai (publishable), quyền truy cập do RLS quyết định.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Khóa LLM cho script so sánh model (npm run compare:models) – chỉ điền trong .env.local
# trên máy dev, không bao giờ commit. App thật đọc khóa từ Supabase Secrets (Edge Functions).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
