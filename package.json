{
  "name": "wordwise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:build": "tsx scripts/build-seed.ts",
    "functions:build": "tsx scripts/build-functions.ts",
    "pregenerate": "tsx --env-file-if-exists=.env.local scripts/pregenerate.ts",
    "compare:models": "tsx --env-file-if-exists=.env.local scripts/compare-models.ts",
    "ocr:accuracy": "tsx --env-file-if-exists=.env.local scripts/ocr-accuracy.ts",
    "pronunciation:smoke": "tsx --env-file-if-exists=.env.local scripts/pronunciation-smoke.ts",
    "srs:simulate": "tsx scripts/simulate-srs.ts",
    "stats:sql": "tsx scripts/build-stats-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@google/genai": "2.27.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "groq-sdk": "1.6.0",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "papaparse": "5.7.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "9.3.10",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "ts-fsrs": "5.4.2",
    "uuid": "14.0.2",
    "wink-lemmatizer": "3.0.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
